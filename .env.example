# Postgres connection (local dev: yarn db:up boots this)
DATABASE_URL="postgresql://yantri:yantri@127.0.0.1:5435/yantri"

# Admin key — required for POST /v1/tenants (generate: openssl rand -hex 32)
ADMIN_API_KEY=""

# Port the API listens on (Daftar's HTTP node calls this)
PORT=3010

# LLM provider: gemini | ollama | stub
# Default: gemini if GEMINI_API_KEY is set, else stub.
# - gemini: AI Studio key. Flash models have a FREE tier (rate-limited, no billing).
# - ollama: local model, zero cost (needs `ollama serve` + a pulled model).
# - stub:   deterministic pseudo-scores for plumbing tests ONLY (loudly labeled).
LLM_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
